{
  "name": "app-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "contract": "pnpm --filter @app/api openapi && pnpm --filter @app/contract generate",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:generate": "pnpm --filter @app/api db:generate",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "overrides": {
      "typescript": "~6.0.3"
    }
  }
}
