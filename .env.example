# Copy to .env. Empty values fall back to dev defaults.

# ---- Required in production ----
# Public URL users open, e.g. https://notes.example.com
APP_URL=http://localhost:5173
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -hex 16 (docker compose only)
POSTGRES_PASSWORD=

# ---- Deployment (docker compose) ----
# Compose project name, unique per app on the same host
APP_NAME=app
# ":80" on the LAN, or your domain for automatic HTTPS
SITE_ADDRESS=:80
# Change ports when several apps share one host (or put one Caddy in front of all apps)
HTTP_PORT=80
HTTPS_PORT=443
# IMAGE_PREFIX=ghcr.io/<you>/<repo>
# TAG=latest

# ---- Local dev only ----
DATABASE_URL=postgres://app:app@localhost:5432/app

# ---- Optional: Keycloak / OIDC SSO (enabled when all three are set) ----
# Redirect URI to register in Keycloak: <APP_URL>/api/auth/callback/keycloak
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Set to false to force SSO only
AUTH_EMAIL_PASSWORD=true

# ---- Optional: observability (cloud free tiers) ----
# API errors
SENTRY_DSN=
# Browser errors (can be the same Sentry project)
PUBLIC_SENTRY_DSN=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
