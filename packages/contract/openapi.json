{
  "openapi": "3.1.0",
  "info": {
    "title": "App API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "PublicConfig": {
        "type": "object",
        "properties": {
          "auth": {
            "type": "object",
            "properties": {
              "emailPassword": {
                "type": "boolean"
              },
              "providers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "emailPassword",
              "providers"
            ]
          },
          "sentryDsn": {
            "type": [
              "string",
              "null"
            ]
          },
          "posthog": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "host": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "host"
            ]
          }
        },
        "required": [
          "auth",
          "sentryDsn",
          "posthog"
        ]
      },
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "body",
          "createdAt",
          "updatedAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "NoteStats": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "day": {
              "type": "string"
            },
            "count": {
              "type": "integer"
            }
          },
          "required": [
            "day",
            "count"
          ]
        }
      },
      "NoteInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "maxLength": 10000,
            "default": ""
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/config": {
      "get": {
        "operationId": "getConfig",
        "tags": [
          "meta"
        ],
        "summary": "Public runtime config for the SPA (auth providers, analytics keys)",
        "responses": {
          "200": {
            "description": "Config",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes": {
      "get": {
        "operationId": "listNotes",
        "tags": [
          "notes"
        ],
        "responses": {
          "200": {
            "description": "Notes of the current user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Note"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createNote",
        "tags": [
          "notes"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes/stats": {
      "get": {
        "operationId": "noteStats",
        "tags": [
          "notes"
        ],
        "summary": "Notes created per day (last 30 days), for the chart",
        "responses": {
          "200": {
            "description": "Daily counts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteStats"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes/{id}": {
      "delete": {
        "operationId": "deleteNote",
        "tags": [
          "notes"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
